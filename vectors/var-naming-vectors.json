     "source": "user.name",
     "shape": {
      "member": [
       "user",
       "name"
      ]
     },
     "explicit": "firstName"
    }
   ],
   "names": [
    "first_name"
   ]
  },
  {
   "id": "reserved",
   "why": "a markup token name is taken: m<N>o and m<N>c are <Phrase>'s",
   "expressions": [
