 "": "Catalog snapshot vectors (spec SNAP-1), shared across Langsys SDKs. AUTHORED in langsys-js-typescript, the owner named by the spec; other lanes vendor this file by blob and never edit their copy.",
 "spec_blob": "b9fd4b5b1c15f7ba29656d550dca1f06013327c0 (langsys2 f5568b88, specVersion 8.2.15)",
 "derived_by": "Expected bytes and digests are computed twice and must agree: by Python's json.dumps(payload, ensure_ascii=False, separators=(',', ':'), sort_keys=True) and hashlib.sha256, which sort by code point and escape exactly as CID-1 does, and by this SDK's canonicalSnapshotJson and sha256Hex.",
 "how_to_row_against_it": {
  "rows": "Serialise every document member except format, version and checksum canonically: the result must equal canonical byte for byte, and \"sha256:\" plus its lowercase hex SHA-256 must equal checksum. Then load document: it must load.",
  "refusals": "Loading document must be refused, with an error naming the reason in refuse: checksum, format, version or missing-member.",
  "loads": "Loading document must succeed, and its catalog for locale must equal expect_catalog."
 },
