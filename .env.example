VITE_LANGSYS_PROJECT_ID=your-project-id-here
VITE_LANGSYS_API_KEY=your-api-key-here

# Optional — only needed for the /e2e testbed. Point at a Langsys API and supply
# one key per permission level to exercise the write-gating lanes.
VITE_LANGSYS_BASE_URL=http://langsys2.test/api
VITE_LANGSYS_KEY_READ=your-read-key-here
VITE_LANGSYS_KEY_IP_WRITE=your-ip-write-key-here
VITE_LANGSYS_KEY_WRITE=your-write-key-here

# HS256 secret the API verifies write grants against. Only needed to mint grants
# in the E2E harness (_dev_/e2e) — never required by the package itself.
#
# NOT VITE_-prefixed, deliberately. That prefix opts a value into Vite's
# client-exposed env, and a grant-signing secret must never be reachable from
# page code. The harness reads it from process.env via `node --env-file`.
LANGSYS_WRITE_GRANT_SECRET=your-write-grant-signing-secret-here
